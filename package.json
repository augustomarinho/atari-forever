{
  "name": "atari-forever",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages && node -e \"require('node:fs').renameSync('dist/pages.html', 'dist/index.html')\"",
    "desktop:dev": "npm exec --package=@tauri-apps/cli@^2 -- tauri dev",
    "desktop:build": "npm exec --package=@tauri-apps/cli@^2 -- tauri build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
