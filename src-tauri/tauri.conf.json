{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atari Forever",
  "version": "0.0.1",
  "identifier": "io.github.atari-forever.emulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atari Forever",
        "width": 1100,
        "height": 700,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  }
}
